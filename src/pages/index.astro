---
import MetaPage from "@/components/MetaPage.astro"
import Layout from "@/layouts/Layout.astro"
---

<Layout>
  <MetaPage slot="head" />

  <main class="home">
    <header class="nav">
      <span class="domain">shefin.dev</span>
      <nav>
        <a href="#about">About</a>
        <a href="#projects">Projects</a>
        <a href="#contact">Contact <span class="blue">↗</span></a>
      </nav>
    </header>

<section class="hero" id="about">
  <div class="hero-text">
    <p class="eyebrow"><span class="dot"></span> DEVELOPER PORTFOLIO</p>
    <h1>Building things<br />for the <span>web.</span></h1>
    <p class="description">
      I'm Shefin Franklin — a developer exploring technology and creating
      useful digital experiences with thoughtful design and code.
    </p>
    <div class="actions">
      <a class="primary" href="#projects">Explore projects <span>↘</span></a>
      <a class="secondary" href="#contact">Get in touch <span>↗</span></a>
    </div>
  </div>

  <div class="portrait">
    <img
      src="/images/profile.jpg"
      alt="Portrait of Shefin Franklin"
      fetchpriority="high"
    />
    <span class="image-label">SHEFIN FRANKLIN / 001</span>
  </div>
</section>

<div class="divider"></div>

<section class="section" id="projects">
  <div class="section-heading">
    <div>
      <p class="eyebrow">WHAT I'M WORKING ON</p>
      <h2>Selected <span>projects.</span></h2>
    </div>
    <span class="index">01 — 02</span>
  </div>

  <div class="projects">
    <article class="project">
      <span class="project-number">01 / WEB</span>
      <h3>Web experiences</h3>
      <p>Clean, responsive websites built with a focus on usability and performance.</p>
      <span class="project-symbol">&lt;/&gt;</span>
    </article>

    <article class="project">
      <span class="project-number">02 / TOOLS</span>
      <h3>Tools &amp; experiments</h3>
      <p>Applications and experiments for exploring ideas and solving practical problems.</p>
      <span class="project-symbol">↗</span>
    </article>
  </div>
  <p class="note">Replace these examples with your actual projects and links.</p>
</section>

<div class="divider"></div>

<section class="contact" id="contact">
  <p class="eyebrow">HAVE AN IDEA?</p>
  <h2>Let's make it<br /><span>happen.</span></h2>
  <p class="description">
    Interested in collaborating or building something together?
    I'd be happy to hear from you.
  </p>
  <a class="primary" href="mailto:hello@shefin.dev">
    Say hello <span>↗</span>
  </a>
  <p class="note">Update the email address if needed.</p>
</section>

<footer>
  <span>© {new Date().getFullYear()} Shefin Franklin</span>
  <a href="#about">Back to top ↑</a>
</footer>

  </main>
</Layout>

<style>
  .home {
    --blue: #3b82f6;
    --blue-strong: #2563eb;
    color: var(--foreground);
  }

  .nav {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.25rem;
    border-bottom: 1px solid var(--border);
  }

  .domain {
    font-size: 0.95rem;
    font-weight: 600;
    letter-spacing: -0.04em;
  }

  .nav nav {
    display: flex;
    align-items: center;
    gap: clamp(0.8rem, 3vw, 1.75rem);
  }

  .nav a,
  footer a {
    color: var(--muted-foreground);
    font-size: 0.82rem;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .nav a:hover,
  footer a:hover {
    color: var(--blue);
  }

  .blue,
  .section-heading h2 span,
  .contact h2 span {
    color: var(--blue);
  }

  .hero {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(200px, 0.65fr);
    align-items: center;
    gap: clamp(2rem, 7vw, 5rem);
    padding-block: clamp(3.5rem, 9vw, 7rem);
  }

  .hero-text {
    min-width: 0;
  }

  .eyebrow {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    margin: 0 0 1.25rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    letter-spacing: 0.09em;
  }

  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--blue);
  }

  h1,
  h2,
  h3,
  p {
    text-wrap: pretty;
  }

  .hero h1 {
    margin: 0;
    font-size: clamp(3.2rem, 7vw, 6rem);
    line-height: 1.02;
    letter-spacing: -0.075em;
    font-weight: 700;
  }

  .hero h1 span {
    color: var(--blue);
  }

  .description {
    max-width: 27rem;
    margin-block: 1.5rem;
    color: var(--muted-foreground);
    font-size: 0.98rem;
    line-height: 1.85;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
  }

  .primary,
  .secondary {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    min-height: 2.75rem;
    padding: 0.75rem 1rem;
    border: 1px solid var(--border);
    border-radius: 5px;
    font-size: 0.82rem;
    text-decoration: none;
    transition:
      background-color 150ms ease,
      border-color 150ms ease;
  }

  .primary {
    border-color: var(--blue-strong);
    background: var(--blue-strong);
    color: #fff;
  }

  .primary:hover {
    border-color: var(--blue);
    background: var(--blue);
  }

  .secondary {
    color: var(--foreground);
  }

  .secondary:hover {
    border-color: var(--blue);
  }

  .portrait {
    position: relative;
    width: 100%;
    max-width: 20rem;
    justify-self: end;
  }

  .portrait img {
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: center 30%;
    border: 1px solid var(--border);
    border-radius: 7px;
    background: #0a0a0a;
  }

  .image-label {
    display: block;
    margin-block-start: 0.75rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.63rem;
    letter-spacing: 0.06em;
  }

  .divider {
    height: 1px;
    background: var(--border);
  }

  .section {
    padding-block: clamp(3.5rem, 8vw, 6rem);
  }

  .section-heading {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-block-end: 1.75rem;
  }

  .section-heading .eyebrow {
    margin-block-end: 0.7rem;
  }

  .section-heading h2,
  .contact h2 {
    margin: 0;
    font-size: clamp(2.2rem, 5vw, 3.5rem);
    font-weight: 600;
    letter-spacing: -0.065em;
    line-height: 1.1;
  }

  .index {
    padding-block-end: 0.4rem;
    color: var(--muted-foreground);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    white-space: nowrap;
  }

  .projects {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1rem;
  }

  .project {
    position: relative;
    min-width: 0;
    min-height: 13rem;
    padding: 1.5rem;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: 6px;
    background: color-mix(in oklab, var(--foreground) 3%, var(--background));
    transition: border-color 150ms ease;
  }

  .project:hover {
    border-color: var(--blue);
  }

  .project-number {
    color: var(--blue);
    font-family: var(--font-mono);
    font-size: 0.65rem;
    letter-spacing: 0.06em;
  }

  .project h3 {
    margin-block: 1.75rem 0.5rem;
    font-size: 1.15rem;
    font-weight: 600;
    letter-spacing: -0.035em;
  }

  .project p {
    max-width: 23rem;
    margin: 0;
    color: var(--muted-foreground);
    font-size: 0.85rem;
    line-height: 1.75;
  }

  .project-symbol {
    position: absolute;
    right: 1.25rem;
    bottom: 0.6rem;
    color: var(--blue);
    font-family: var(--font-mono);
    font-size: 2.2rem;
    opacity: 0.18;
  }

  .note {
    margin-block: 1rem 0;
    color: var(--muted-foreground);
    font-size: 0.75rem;
    line-height: 1.7;
  }

  .contact {
    padding-block: clamp(3.5rem, 8vw, 6rem);
    border-top: 1px solid var(--border);
  }

  .contact .description {
    margin-block: 1rem 1.5rem;
  }

  .contact .note {
    margin-block-start: 0.75rem;
  }

  footer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    padding-block: 1.5rem;
    border-top: 1px solid var(--border);
  }

  footer span {
    color: var(--muted-foreground);
    font-size: 0.75rem;
  }

  @media (max-width: 42rem) {
    .hero {
      grid-template-columns: minmax(0, 1fr);
      gap: 2.5rem;
    }

    .hero h1 {
      font-size: clamp(3.2rem, 13vw, 5rem);
    }

    .portrait {
      justify-self: start;
      max-width: 19rem;
    }

    .section-heading {
      align-items: start;
    }

    .projects {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 27rem) {
    .nav {
      align-items: flex-start;
      flex-direction: column;
    }

    .nav nav {
      width: 100%;
      justify-content: space-between;
    }

    .actions {
      align-items: stretch;
      flex-direction: column;
    }

    footer {
      align-items: flex-start;
      flex-direction: column;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .home *,
    .home *::before,
    .home *::after {
      transition: none !important;
    }
  }
</style>
